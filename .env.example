# Google Cloud Console -> OAuth client (Web). Authorised JS origin = your app origin.
VITE_GOOGLE_CLIENT_ID=
# Azure portal -> App registration (SPA). Redirect URI = <origin>/oauth-callback.html
VITE_MS_CLIENT_ID=
# Optional: enables the native Google Picker so users can choose ANY existing Drive folder.
# Google Cloud -> Credentials -> API key (enable "Google Picker API"), restricted to your origin.
VITE_GOOGLE_API_KEY=
